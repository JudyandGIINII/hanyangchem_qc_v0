{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "bottom": {
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "left": {
          "minimum": 0,
          "title": "Left",
          "type": "number"
        },
        "right": {
          "minimum": 0,
          "title": "Right",
          "type": "number"
        },
        "top": {
          "minimum": 0,
          "title": "Top",
          "type": "number"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "ExtractionValue": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "item_key": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Item Key",
          "type": "string"
        },
        "normalized_value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Value"
        },
        "provenance": {
          "$ref": "#/$defs/SourceReference"
        },
        "raw_text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        },
        "review_required": {
          "title": "Review Required",
          "type": "boolean"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "item_key",
        "raw_text",
        "provenance",
        "confidence",
        "review_required"
      ],
      "title": "ExtractionValue",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "source_reference": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Reference",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "source_reference",
        "page_number",
        "bbox"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "document": {
      "$ref": "#/$defs/SourceReference"
    },
    "provider_name": {
      "const": "synthetic-fixture",
      "title": "Provider Name",
      "type": "string"
    },
    "review_required": {
      "title": "Review Required",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "values": {
      "items": {
        "$ref": "#/$defs/ExtractionValue"
      },
      "minItems": 1,
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "created_at",
    "document",
    "provider_name",
    "values",
    "review_required"
  ],
  "title": "ExtractionCandidate",
  "type": "object"
}
