{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "properties": {
        "bottom": {
          "minimum": 0,
          "title": "Bottom",
          "type": "number"
        },
        "left": {
          "minimum": 0,
          "title": "Left",
          "type": "number"
        },
        "right": {
          "minimum": 0,
          "title": "Right",
          "type": "number"
        },
        "top": {
          "minimum": 0,
          "title": "Top",
          "type": "number"
        }
      },
      "required": [
        "left",
        "top",
        "right",
        "bottom"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "ExtractionRecipe": {
      "enum": [
        "adaptive-threshold",
        "grayscale-clahe",
        "native-text",
        "original",
        "otsu-denoise-sharpen"
      ],
      "type": "string"
    },
    "ExtractionReviewReason": {
      "enum": [
        "HUMAN_REVIEW_REQUIRED",
        "LOT_CONFLICT",
        "LOW_CONFIDENCE",
        "MISSING_REQUIRED",
        "NATIVE_OCR_DISAGREEMENT",
        "NUMERIC_CONFLICT",
        "TABLE_LAYOUT_REVIEW_REQUIRED",
        "UNIT_CONFLICT",
        "VARIANT_DISAGREEMENT"
      ],
      "type": "string"
    },
    "ExtractionValue": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "deskew_millidegrees": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": -10000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deskew Millidegrees"
        },
        "deskew_status": {
          "anyOf": [
            {
              "enum": [
                "NOT_NEEDED",
                "APPLIED",
                "OUT_OF_BOUNDS"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deskew Status"
        },
        "item_key": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
          "title": "Item Key",
          "type": "string"
        },
        "normalized_value": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Value"
        },
        "perspective_corrected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perspective Corrected"
        },
        "provenance": {
          "$ref": "#/$defs/SourceReference"
        },
        "raw_text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        },
        "reading_order": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reading Order"
        },
        "reason_codes": {
          "items": {
            "$ref": "#/$defs/ExtractionReviewReason"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "recipe_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractionRecipe"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "review_required": {
          "title": "Review Required",
          "type": "boolean"
        },
        "rotation_degrees": {
          "anyOf": [
            {
              "enum": [
                0,
                90,
                180,
                270
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation Degrees"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "variant_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variant Id"
        }
      },
      "required": [
        "item_key",
        "raw_text",
        "provenance",
        "confidence",
        "review_required"
      ],
      "title": "ExtractionValue",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "document_id": {
          "format": "uuid",
          "title": "Document Id",
          "type": "string"
        },
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "source_reference": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Source Reference",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "source_reference",
        "page_number",
        "bbox"
      ],
      "title": "SourceReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "format": "uuid",
      "title": "Candidate Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "document": {
      "$ref": "#/$defs/SourceReference"
    },
    "provider_name": {
      "enum": [
        "local-paddleocr",
        "synthetic-fixture"
      ],
      "title": "Provider Name",
      "type": "string"
    },
    "review_required": {
      "title": "Review Required",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "values": {
      "items": {
        "$ref": "#/$defs/ExtractionValue"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "created_at",
    "document",
    "provider_name",
    "values",
    "review_required"
  ],
  "title": "ExtractionCandidate",
  "type": "object"
}
