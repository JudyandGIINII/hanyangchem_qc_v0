# Placeholder-only local development settings. Do not put real credentials here.
POSTGRES_DB=hyc
POSTGRES_USER=local_user
POSTGRES_PASSWORD=local-placeholder-only
DATABASE_URL=postgresql+psycopg://local_user:local-placeholder-only@postgres:5432/hyc
REDIS_URL=redis://redis:6379/0
CHECK_DATABASE_ON_READY=true
CHECK_REDIS_ON_READY=true
# Loopback-only Compose host bindings; container ports remain 8000 (API) and 3000 (web).
HYC_API_HOST_PORT=18000
HYC_WEB_HOST_PORT=13000
# Vercel public synthetic feedback demo only. Set to 1 as a build-time variable;
# leave 0/unset for the default localhost P3 API behavior.
NEXT_PUBLIC_HYC_PUBLIC_DEMO=0
# NCR module exposure flags. They affect only client visibility, never decision guards.
HYC_NCR_REPORT_MODULE_ENABLED=false
HYC_NCR_APPROVER_MODULE_ENABLED=false
HYC_NCR_RETEST_MODULE_ENABLED=false
HYC_NCR_ATTACHMENT_MODULE_ENABLED=false
HYC_NCR_COMPLETION_DATE_MODULE_ENABLED=false
# Local-only OCR is opt-in and fails readiness when its pinned local models are absent.
HYC_LOCAL_OCR_ENABLED=false
HYC_LOCAL_OCR_MANIFEST_PATH=backend/local_ocr/model-manifest.v1.json
HYC_LOCAL_OCR_MODELS_ROOT=.local-ocr-models/models
# Ingestion seam flag for NAS/Drive (default false)
HYC_INGEST_ENABLED=false
